<%- include("partials/header") %>
<div class="container my-4">
  <h1 class="h2 mb-3">Adatbázis</h1>
  <form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
      <select name="np" class="form-select" onchange="this.form.submit()" aria-label="Nemzeti park szűrő">
        <option value="">Minden nemzeti park igazgatóság</option>
        <% nps.forEach(n => { %><option value="<%= n.id %>" <%= npId === n.id ? "selected" : "" %>><%= n.nev %></option><% }); %>
      </select>
    </div>
    <div class="col-auto"><noscript><button class="btn btn-success">Szűrés</button></noscript></div>
  </form>

  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#ut" type="button">Tanösvények (<%= utak.length %>)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tel" type="button">Települések (<%= telepulesek.length %>)</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#np" type="button">Nemzeti parkok (<%= nps.length %>)</button></li>
  </ul>
  <div class="tab-content pt-3">
    <div class="tab-pane fade show active" id="ut">
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-success"><tr><th>Név</th><th>Hossz (km)</th><th>Állomások</th><th>Idő (óra)</th><th>Idegenvezetés</th><th>Település</th><th>Nemzeti park</th></tr></thead>
          <tbody>
          <% utak.forEach(u => { %>
            <tr>
              <td><%= u.nev %></td><td><%= u.hossz %></td><td><%= u.allomas %></td><td><%= u.ido %></td>
              <td><%= u.vezetes ? "Van" : "Nincs" %></td>
              <td><%= u.telepules ? u.telepules.nev : "-" %></td>
              <td><%= u.telepules && u.telepules.np ? u.telepules.np.nev : "-" %></td>
            </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="tab-pane fade" id="tel">
      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead class="table-success"><tr><th>Azonosító</th><th>Település</th><th>Nemzeti park</th></tr></thead>
          <tbody>
          <% telepulesek.forEach(t => { %>
            <tr><td><%= t.id %></td><td><%= t.nev %></td><td><%= t.np ? t.np.nev : "-" %></td></tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="tab-pane fade" id="np">
      <div class="table-responsive">
        <table class="table table-striped align-middle">
          <thead class="table-success"><tr><th>Azonosító</th><th>Név</th></tr></thead>
          <tbody>
          <% nps.forEach(n => { %><tr><td><%= n.id %></td><td><%= n.nev %></td></tr><% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<%- include("partials/footer") %>
